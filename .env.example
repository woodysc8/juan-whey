# Free "Self-Service" app credentials from https://developers.amadeus.com
# Sign up -> My Self-Service Workspace -> Create New App
AMADEUS_CLIENT_ID=your_client_id_here
AMADEUS_CLIENT_SECRET=your_client_secret_here

# Leave as-is unless Amadeus approves you for production access later
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Active flight-search provider. SerpApi is the current working provider.
FLIGHT_PROVIDER=serpapi
SERPAPI_API_KEY=your_serpapi_api_key_here
# Optional request timeout, in milliseconds (defaults to 30000)
SERPAPI_TIMEOUT_MS=30000

# Flight providers: serpapi | letsfg. LetsFG uses its free agent bearer-token path.
LETSFG_BEARER_TOKEN=
# Optional LetsFG full-search timeout, in milliseconds (defaults to 90000)
LETSFG_TIMEOUT_MS=90000

# Bounds live destination/flight research calls (defaults: 5 candidates, 2 providers each).
MAX_DESTINATION_CANDIDATES=5
MAX_FLIGHT_PROVIDERS_PER_DESTINATION=2

# Active hotel provider: stayingapi. A free no-card key is required for live search.
HOTEL_PROVIDER=stayingapi
STAYINGAPI_KEY=
STAYINGAPI_TIMEOUT_MS=30000
# Maximum normalized hotel properties per destination in bounded trip research.
MAX_HOTEL_PROPERTIES=5

# Streamable HTTP MCP adapter. Use explicit, never-wildcard allowlists.
# Unauthenticated operation is permitted only on a loopback host.
MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT wins. If omitted, the server uses PORT (for Render) then 3100.
MCP_HTTP_PORT=3100
MCP_PUBLIC_BASE_URL=http://127.0.0.1:3100
MCP_ALLOWED_ORIGINS=http://127.0.0.1:3100
MCP_ALLOWED_HOSTS=127.0.0.1,localhost
MCP_AUTH_REQUIRED=false
# Required only when MCP_AUTH_REQUIRED=true. These are public identifiers/URLs,
# never client secrets or private keys. Configure at least one authorization
# restriction: comma-separated scopes and/or comma-separated JWT subjects.
MCP_AUTH_ISSUER=https://issuer.example.com/
MCP_AUTH_AUDIENCE=juan-whey-mcp
MCP_AUTH_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
MCP_AUTH_REQUIRED_SCOPES=juan.mcp
# For Google service-account ID tokens, leave MCP_AUTH_REQUIRED_SCOPES empty and
# set this to the trusted service account's immutable numeric JWT `sub` value.
MCP_AUTH_ALLOWED_SUBJECTS=
# Optional request/session safety limits.
MCP_HTTP_MAX_BODY_BYTES=1000000
MCP_HTTP_MAX_CONCURRENT_REQUESTS=10
MCP_HTTP_MAX_SESSIONS=10
MCP_HTTP_REQUEST_TIMEOUT_MS=30000
